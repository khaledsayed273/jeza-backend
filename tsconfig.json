{
  "include": ["src/**/*", "drizzle/**/*"],
  "exclude": ["node_modules", "dist", "tests"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",

    "rootDir": ".",
    "outDir": "./dist",

    "noEmit": false,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",

    "strict": true,
    "lib": ["esnext"],

    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}